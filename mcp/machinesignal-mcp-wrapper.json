  "machine_installation_flow": [
    {
      "step": 1,
      "machine_action": "Fetch this wrapper pack.",
      "call": "GET https://machinesignal.it/mcp/machinesignal-mcp-wrapper.json",
      "credits_consumed": false
    },
    {
      "step": 2,
      "machine_action": "Fetch the tool manifest and list available tools.",
      "call": "GET https://machinesignal.it/mcp-tool-manifest.json",
      "credits_consumed": false
    },
    {
      "step": 3,
      "machine_action": "Clone the repository and start the local stdio adapter.",
      "command": "git clone https://github.com/machinesignal-it/machinesignal-lead-opportunity-score.git && cd machinesignal-lead-opportunity-score && python mcp_adapter/machinesignal_mcp_server.py",
      "credits_consumed": false
    },
    {
      "step": 4,
      "machine_action": "Validate installation without using credits.",
      "command": "python mcp_adapter/validate_machine_client_installation_20260603.py",
      "credits_consumed": false
    },
    {
      "step": 5,
      "machine_action": "Run the buyer-machine sandbox flow only if sandbox credits are available.",
      "command": "python mcp_adapter/machine_buyer_agent_runner_20260603.py",
      "credits_consumed": true
    }
  ],
