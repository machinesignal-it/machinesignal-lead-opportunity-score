{
  "service": "MachineSignal",
  "version": "2026-06-01",
  "artifact_type": "rapidapi_provider_setup_checklist",
  "recommended_mode": "draft_or_unpublished",
  "do_not_publish_monetized_until": [
    "7-day sandbox metrics reviewed",
    "abuse limits confirmed",
    "terms reviewed",
    "external API-tool test completed",
    "cost per valid output checked"
  ],
  "provider_fields": {
    "api_name": "MachineSignal Lead Opportunity Score API",
    "short_description": "Machine-first lead opportunity scoring API for CRM workflows, RevOps automations and AI agents.",
    "category": "Business / Sales Intelligence / CRM / Data Enrichment / AI Agent Tools",
    "tags": [
      "lead-scoring",
      "crm",
      "revops",
      "ai-agents",
      "b2b",
      "sales-automation",
      "data-enrichment",
      "lead-routing",
      "openapi",
      "machine-customer"
    ],
    "base_url": "https://machinesignal-api.beta-878.workers.dev",
    "openapi_url": "https://machinesignal.it/openapi.json",
    "public_documentation_url": "https://machinesignal.it/distribution/rapidapi-listing.json",
    "public_postman_collection": "https://machinesignal.it/postman_public_collection.json"
  },
  "endpoint_groups": [
    {
      "name": "Public discovery",
      "auth_required": false,
      "endpoints": [
        "GET /health",
        "GET /machine-onboarding.json",
        "GET /product-catalog.json",
        "GET /openapi.json",
        "GET /postman_collection.json"
      ]
    },
    {
      "name": "Sandbox onboarding",
      "auth_required": false,
      "endpoints": [
        "POST /v1/sandbox/customers"
      ],
      "purpose": "Create a low-credit sandbox key for machine evaluation without manual sales contact."
    },
    {
      "name": "Customer API",
      "auth_required": true,
      "headers": [
        "X-API-Key",
        "Idempotency-Key for chargeable POST requests"
      ],
      "endpoints": [
        "GET /v1/onboarding",
        "GET /v1/usage",
        "POST /v1/lead-opportunity-score",
        "POST /v1/purchase-intent",
        "GET /v1/orders",
        "GET /v1/orders/{order_intent_id}"
      ]
    }
  ],
  "example_requests": {
    "create_sandbox_customer": {
      "method": "POST",
      "path": "/v1/sandbox/customers",
      "body": {
        "evaluator_type": "ai_agent",
        "integration_target": "crm_workflow",
        "expected_test_path": "full_flow"
      }
    },
    "score_domain": {
      "method": "POST",
      "path": "/v1/lead-opportunity-score",
      "headers": {
        "X-API-Key": "<sandbox_or_customer_key>",
        "Idempotency-Key": "rapidapi-demo-score-001"
      },
      "body": {
        "domain": "clinic3.it",
        "sector_hint": "dentist",
        "country_hint": "IT"
      }
    },
    "buy_deep_analysis_beta": {
      "method": "POST",
      "path": "/v1/purchase-intent",
      "headers": {
        "X-API-Key": "<sandbox_or_customer_key>",
        "Idempotency-Key": "rapidapi-demo-deep-analysis-001"
      },
      "body": {
        "product_code": "deep_analysis",
        "domain": "clinic3.it",
        "source_score_request_id": "rapidapi-demo-score-001",
        "reason": "Score decision was buy_deep_analysis"
      }
    },
    "buy_action_pack_beta": {
      "method": "POST",
      "path": "/v1/purchase-intent",
      "headers": {
        "X-API-Key": "<sandbox_or_customer_key>",
        "Idempotency-Key": "rapidapi-demo-action-pack-001"
      },
      "body": {
        "product_code": "action_pack",
        "domain": "clinic3.it",
        "source_score_request_id": "rapidapi-demo-score-001",
        "reason": "Deep Analysis confirmed an opportunity and the CRM needs a machine-readable next action"
      }
    }
  },
  "draft_pricing_reference": {
    "score_pack_1k": "EUR 99",
    "target_discovery_pack_250": "EUR 149",
    "domain_enrichment_pack_100": "EUR 149",
    "deep_analysis_pack_100": "EUR 299",
    "action_pack_25": "EUR 399",
    "opportunity_feed_monthly": "EUR 249/month",
    "api_starter_monthly": "EUR 99/month",
    "api_pro_monthly": "EUR 499/month"
  },
  "acceptance_tests": [
    "Public listing loads",
    "OpenAPI is accepted or docs can be entered manually",
    "Public endpoints return HTTP 200",
    "POST /v1/sandbox/customers returns an api_key",
    "Protected endpoints work with sandbox key",
    "Repeated score with same Idempotency-Key does not double consume credit",
    "Purchase intent returns JSON delivery and does not execute payment",
    "GET /v1/orders retrieves the delivery"
  ],
  "safety": {
    "real_payment_executed_in_beta": false,
    "external_contact_executed_by_machinesignal": false,
    "action_pack_sends_email": false,
    "requires_customer_compliance_gate_before_external_action": true
  }
}
