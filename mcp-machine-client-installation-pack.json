  "install_steps": [
    {
      "step": 1,
      "name": "clone_repository",
      "command": "git clone https://github.com/machinesignal-it/machinesignal-lead-opportunity-score.git"
    },
    {
      "step": 2,
      "name": "enter_repository",
      "command": "cd machinesignal-lead-opportunity-score"
    },
    {
      "step": 3,
      "name": "validate_without_consuming_credits",
      "command": "python mcp_adapter/validate_machine_client_installation_20260603.py",
      "credit_consuming_calls_executed": false
    },
    {
      "step": 4,
      "name": "run_full_buyer_machine_test",
      "command": "python mcp_adapter/machine_buyer_agent_runner_20260603.py",
      "uses_sandbox_credits": true
    }
  ],
