  "plain_italian_summary": "Questa bozza definisce come dovra' essere tracciata l'accettazione dei termini quando l'API viene usata da una macchina. La macchina puo' chiamare e consumare API solo se e' collegata a un account umano o aziendale responsabile che ha accettato una versione specifica dei termini.",
  "core_rule": {
    "machine_can_use_api": true,
    "machine_can_accept_legal_terms_alone": false,
    "human_or_company_owner_required": true,
    "acceptance_must_be_versioned": true,
    "acceptance_must_be_auditable": true,
    "acceptance_must_be_revocable": true
  },
  "acceptance_states": [
    {
      "state": "not_present",
      "meaning": "No responsible account and no accepted terms.",
      "allowed_actions": [
        "read_public_docs_if_publicly_approved_future",
        "use_synthetic_demo_without_account_if_approved_future"
      ],
      "blocked_actions": [
        "issue_api_key",
        "consume_paid_credits",
        "process_real_data",
        "buy_deepening",
        "target_discovery"
      ]
    },
    {
      "state": "sandbox_accepted",
      "meaning": "Human/company owner accepted sandbox-only terms.",
      "allowed_actions": [
        "synthetic_sandbox_calls",
        "read_machine_readable_terms",
        "view_usage_simulation"
      ],
      "blocked_actions": [
        "real_payments",
        "invoices",
        "real_data_processing",
        "production_api_key_issuing",
        "external_outreach"
      ]
    },
    {
      "state": "pre_live_owner_approved",
      "meaning": "Owner approves controlled pre-live testing with strict limits.",
      "allowed_actions": [
        "controlled_internal_tests",
        "synthetic_batch_tests",
        "cost_guard_rehearsal"
      ],
      "blocked_actions": [
        "paid_sale",
        "payment_method_collection",
        "personal_data_processing",
        "public_marketplace_publication",
        "hosted_mcp_public"
      ]
    },
    {
      "state": "future_live_accepted",
      "meaning": "Future state only: terms, privacy, DPA, fiscal and payment gates are approved.",
      "allowed_actions": [
        "to_be_defined_after_owner_approval"
      ],
      "blocked_actions_now": [
        "all_live_actions_until_explicit_owner_approval"
      ]
    }
  ],
  "required_acceptance_record": {
    "account_owner_id": "pseudonymous_string_required_future",
    "account_owner_type": "company | individual_professional | other_approved_owner_type",
    "accepted_terms_version": "string_required",
    "accepted_privacy_version": "string_required",
    "accepted_dpa_version": "string_or_null",
    "accepted_at": "iso_datetime_required",
    "accepted_from": "web_ui | api_console | signed_order | admin_record",
    "accepted_by_human": true,
    "machine_client_id": "string_required_for_api_usage",
    "api_key_prefix": "string_required_never_full_key",
    "environment": "sandbox | pre_live | future_live",
    "allowed_products": "array",
    "allowed_data_scope": "synthetic_only | approved_business_domain_data_future",
    "terms_hash": "string_required_future",
    "privacy_hash": "string_required_future",
    "ip_or_device_metadata_policy": "to_be_approved_before_collection",
    "revoked_at": "iso_datetime_or_null",
    "revocation_reason": "string_or_null"
  },
  "flow_steps": [
    {
      "step": 1,
      "name": "Identify responsible owner",
      "actor": "human_or_company_owner",
      "machine_role": "none",
      "output": "owner record candidate",
      "blocks_if_missing": [
        "api_key_issuance",
        "credit_consumption",
        "live_usage"
      ]
    },
    {
      "step": 2,
      "name": "Present terms and privacy versions",
      "actor": "system",
      "machine_role": "can_read_machine_summary_only",
      "output": "versioned terms/privacy presented",
      "blocks_if_missing": [
        "terms_acceptance",
        "api_key_issuance"
      ]
    },
    {
      "step": 3,
      "name": "Human/company owner accepts",
      "actor": "human_or_company_owner",
      "machine_role": "cannot_accept_alone",
      "output": "accepted_terms_version and accepted_privacy_version",
      "blocks_if_missing": [
        "all_non_public_usage"
      ]
    },
    {
      "step": 4,
      "name": "Bind machine client to owner",
      "actor": "system",
      "machine_role": "identified_api_client",
      "output": "machine_client_id linked to owner",
      "blocks_if_missing": [
        "api_calls_with_credits",
        "usage_audit"
      ]
    },
    {
      "step": 5,
      "name": "Issue environment-scoped key",
      "actor": "system_or_owner_approved_admin",
      "machine_role": "receives_key_prefix_only_in_logs",
      "output": "api_key_prefix and environment policy",
      "blocks_if_missing": [
        "api_usage"
      ],
      "current_status": "sandbox_design_only_no_live_key"
    },
    {
      "step": 6,
      "name": "Audit each credit-consuming call",
      "actor": "ledger",
      "machine_role": "api_client",
      "output": "ledger row with request_id, product_code, idempotency_key and credit_delta",
      "blocks_if_missing": [
        "credit_charge",
        "future_invoice_reconciliation"
      ]
    },
    {
      "step": 7,
      "name": "Handle terms version changes",
      "actor": "system",
      "machine_role": "receives policy status",
      "output": "reacceptance_required flag if terms change materially",
      "blocks_if_missing": [
        "future_live_usage_after_material_change"
      ]
    },
    {
      "step": 8,
      "name": "Revoke access if policy breached",
      "actor": "system_or_owner_approved_admin",
      "machine_role": "receives blocked/error response",
      "output": "revoked_at and revocation_reason",
      "blocks_if_missing": [
        "continued_abusive_usage"
      ]
    }
  ],
