  "request_flow": [
    {
      "step": 1,
      "name": "machine_discovers_public_manifest",
      "description": "Machine reads public discovery assets and learns that hosted MCP is not live yet."
    },
    {
      "step": 2,
      "name": "machine_attempts_protected_mcp",
      "description": "Future MCP endpoint responds with OAuth protected-resource metadata or a clear not-live response until launch."
    },
    {
      "step": 3,
      "name": "machine_obtains_scoped_token",
      "description": "Future machine obtains a scoped token through approved authorization server."
    },
    {
      "step": 4,
      "name": "machine_lists_tools",
      "description": "MCP tools/list returns only tools allowed by token scope."
    },
    {
      "step": 5,
      "name": "machine_calls_tool",
      "description": "Tool call validates schema, scope, idempotency, customer binding, quota and spend policy before execution."
    },
    {
      "step": 6,
      "name": "state_and_audit",
      "description": "Durable Object records quota, ledger and audit event. KV is not used for per-call writes."
    },
    {
      "step": 7,
      "name": "structured_response",
      "description": "MCP response returns structured JSON with decision, evidence, usage impact, next_allowed_machine_action and errors if any."
    }
  ],
