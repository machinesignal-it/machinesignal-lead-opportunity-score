    "purpose": "Allow an agent, CRM workflow or software automation to call MachineSignal as MCP-style tools while the public hosted MCP server is not live yet.",
    "buyer_agent_tested_flow": "A machine buyer can start without a prospect list, buy target discovery, score one discovered target and buy the recommended deep analysis deliverable.",
    "guardrails": {
      "full_api_keys_returned_to_client": false,
      "real_payment_executed_in_beta": false,
      "external_contact_executed_in_beta": false
    }
  },
  "sandbox_flow": [
    {
      "step": 1,
      "method": "GET",
      "endpoint": "/machine-onboarding.json",
      "goal": "Read machine contract and allowed flow."
    },
    {
      "step": 2,
      "method": "GET",
      "endpoint": "/product-catalog.json",
      "goal": "Read products, prices, deliverables and credit rules."
    },
    {
      "step": 3,
      "method": "POST",
      "endpoint": "/v1/sandbox/customers",
      "goal": "Create a low-credit sandbox key without human sales contact."
    },
    {
      "step": 4,
      "method": "GET",
      "endpoint": "/v1/onboarding",
      "auth": "X-API-Key",
      "goal": "Read customer-specific credits and next possible calls."
    },
    {
      "step": 5,
      "method": "POST",
      "endpoint": "/v1/lead-opportunity-score",
      "auth": "X-API-Key",
      "headers": [
        "Idempotency-Key"
      ],
      "goal": "Score a domain and receive decision, web_architect_review, commercial_strength, spend_policy and next budget action."
    },
    {
      "step": 6,
      "method": "POST",
      "endpoint": "/v1/purchase-intent",
      "auth": "X-API-Key",
      "headers": [
        "Idempotency-Key"
      ],
      "goal": "Order target_discovery, deep_analysis or action_pack when the machine has a valid reason."
    },
    {
      "step": 7,
      "method": "GET",
      "endpoint": "/v1/orders",
      "auth": "X-API-Key",
      "goal": "Retrieve previous beta deliveries and audit output."
    }
  ],
  "products_to_test": {
    "target_discovery": {
      "when_to_buy": "The machine has a market and commercial objective, but no starting list.",
      "output": "250 coherent target records or a no-go market coverage decision in production; sandbox returns a sample and output contract.",
      "beta_price_eur": 149
    },
    "domain_enrichment": {
      "when_to_buy": "The machine has company names but needs reliable domains before scoring.",
      "output": "100 enrichment decisions in production; sandbox returns a sample and output contract.",
      "beta_price_eur": 149
    },
    "score_pack_1k": {
      "when_to_buy": "The machine has domains and needs priority, decision, commercial strength and next budget action.",
      "output": "1000 valid scores with opportunity_score, confidence, web_architect_review, commercial_strength, spend_policy, allowed_next_products and next_purchase.",
      "beta_price_eur": 99
    },
    "deep_analysis": {
      "when_to_buy": "A score recommends buy_deep_analysis or the machine needs a deeper decision before spending campaign or human time.",
      "output": "One deep opportunity decision pack per consumed credit.",
      "beta_price_eur": 299
    },
    "action_pack": {
      "when_to_buy": "Deep Analysis confirms a useful opportunity, commercial_strength is strong, Web Architect evidence supports controlled action, and the machine needs CRM/workflow-ready output.",
      "output": "CRM record patch, task, workflow payload, webhook event, approval gate, stop rules and audit event.",
      "beta_price_eur": 399
    }
  },
  "machine_success_metrics": {
    "sandbox_keys_created_target_7_days": 10,
