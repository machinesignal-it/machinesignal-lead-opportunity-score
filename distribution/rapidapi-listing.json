      "when_bought_by_machine": "A machine wants to evaluate whether the dentist vertical beta funnel is worth testing before creating sandbox calls."
    },
    {
      "product_code": "target_discovery",
      "name": "Target Discovery Pack",
      "price_eur": 149,
      "unit": "250 coherent target records or no-go market coverage decision",
      "when_bought_by_machine": "The customer machine has no starting list and needs coherent targets for a declared commercial objective."
    },
    {
      "product_code": "domain_enrichment",
      "name": "Domain Enrichment Pack 100",
      "price_eur": 149,
      "unit": "100 enrichment decisions",
      "when_bought_by_machine": "The customer machine has company names or partial records but needs reliable domains before scoring."
    },
    {
      "product_code": "score_pack_1k",
      "name": "Score Pack 1k",
      "price_eur": 99,
      "unit": "1000 valid scores",
      "when_bought_by_machine": "The customer machine has domains and wants score, confidence, decision and next budget action."
    },
    {
      "product_code": "deep_analysis",
      "name": "Deep Analysis Pack 100",
      "price_eur": 299,
      "unit": "100 valid deep analyses",
      "when_bought_by_machine": "A scored domain is promising and the machine needs a deeper decision before buying an action pack."
    },
    {
      "product_code": "action_pack",
      "name": "Action Pack 25",
      "price_eur": 399,
      "unit": "25 valid action packs",
      "when_bought_by_machine": "A confirmed opportunity needs CRM-ready payloads, workflow payload, webhook event, approval gate and stop rules."
    },
    {
      "product_code": "opportunity_feed",
      "name": "Opportunity Feed",
      "price_eur": 249,
      "unit": "4 scans and 4 deliveries per month",
      "when_bought_by_machine": "The customer machine wants recurring discovery and delivery rather than one-off scoring."
    }
  ],
