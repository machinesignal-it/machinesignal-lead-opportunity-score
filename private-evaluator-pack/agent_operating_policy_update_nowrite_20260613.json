  "conditionally_allowed_actions": [
    {
      "action": "public_docs_update",
      "condition": "Only if already approved content and no marketplace/paid/live claim is introduced."
    },
    {
      "action": "sandbox_demo_update",
      "condition": "Synthetic data only, no real user/customer data, no payment collection."
    },
    {
      "action": "support_response",
      "condition": "Only ordinary cases from support_privacy_terms_playbook; no legal/fiscal/payment decision."
    },
    {
      "action": "api_contract_change",
      "condition": "No production key issuance, no live endpoint promise, no real data enablement."
    }
  ],
  "hard_stop_actions": [
    "real_payments",
    "invoices",
    "payment_method_collection",
    "external_outreach",
    "email_sending_to_humans",
    "real_data_processing",
    "personal_data_processing",
    "production_api_key_issuing",
    "public_paid_marketplace",
    "hosted_mcp_public",
    "mcp_registry_publication",
    "commercial_go_live",
    "claim_legal_approval",
    "publish_final_terms",
    "publish_final_privacy_notice",
    "treat_machine_as_sole_legal_counterparty"
  ],
  "agent_decision_protocol": [
    {
      "step": 1,
      "name": "Classify requested action",
      "required_check": "Is this NoWrite/internal, sandbox synthetic, support ordinary, or live/commercial?"
    },
    {
      "step": 2,
      "name": "Check hard stops",
      "required_check": "If action matches hard_stop_actions, stop and record blocked_reason."
    },
    {
      "step": 3,
      "name": "Check data scope",
      "required_check": "If real or personal data is present, block and escalate."
    },
    {
      "step": 4,
      "name": "Check externality",
      "required_check": "If action contacts external humans/systems publicly, require explicit owner approval."
    },
    {
      "step": 5,
      "name": "Check cost and write limits",
      "required_check": "If action writes to external systems or can create cost, apply cost guard."
    },
    {
      "step": 6,
      "name": "Produce one bounded artifact",
      "required_check": "Do one complete step, validate, commit/push when appropriate, then report next step."
    }
  ],
  "self_improvement_loop": {
    "allowed": true,
    "frequency": "after_each_validated_step",
    "method": [
      "read_latest_probe_summary",
      "identify recurring failure or gap",
      "propose small policy/doc/test improvement",
      "apply only if NoWrite/internal and within hard stops",
      "validate with probe",
      "record readiness impact"
    ],
    "not_allowed": [
      "changing hard stops without owner approval",
      "learning from real personal data",
      "auto-publishing to public channels",
      "auto-starting paid tools or subscriptions",
      "auto-contacting prospects"
    ],
    "memory_artifacts": [
      "private-evaluator-pack reports",
      "probe summaries",
      "agent reviews",
      "readiness matrices",
      "support playbooks",
      "data maps"
    ]
  },
