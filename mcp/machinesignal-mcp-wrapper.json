  "machine_buyer_test_flow": [
    "read public catalog",
    "read machine onboarding",
    "read direct sandbox test contract",
    "create sandbox customer",
    "read authenticated onboarding",
    "if no list exists, buy target_discovery",
    "score one selected domain",
    "buy only the recommended add-on when spend policy allows it",
    "create payment-test intent in sandbox or test mode",
    "reconcile payment test",
    "read orders and usage"
  ],
