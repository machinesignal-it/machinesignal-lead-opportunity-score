{
  "openapi": "3.1.0",
  "info": {
    "title": "MachineSignal Lead Opportunity Score API",
    "version": "0.1.0-beta",
    "description": "Beta API contract for scoring business domains and returning machine-readable opportunity signals for CRM, RevOps and AI-agent workflows.",
    "contact": {
      "name": "Team MachineSignal",
      "email": "beta@machinesignal.it",
      "url": "https://machinesignal.it/"
    }
  },
  "servers": [
    {
      "url": "https://machinesignal-api.beta-878.workers.dev",
      "description": "Callable public synthetic beta endpoint."
    },
    {
      "url": "https://api.machinesignal.it",
      "description": "Planned custom API host."
    }
  ],
  "x-machine-discovery": {
    "primary_customer_interface": "machine",
    "human_role": "supervision, approval and audit only",
    "machine_onboarding": "https://machinesignal.it/machine-onboarding.json",
    "canonical_machine_onboarding": "https://machinesignal-api.beta-878.workers.dev/machine-onboarding.json",
    "llms": "https://machinesignal.it/llms.txt",
    "canonical_llms": "https://machinesignal-api.beta-878.workers.dev/llms.txt",
    "machine_first_rule": "Use callable endpoints, OpenAPI and manifests. Do not rely on human email persuasion as the primary sales channel."
  },
  "paths": {
    "/machine-onboarding.json": {
      "get": {
        "operationId": "getMachineOnboardingManifest",
        "summary": "Return public machine-readable onboarding manifest",
        "description": "Public manifest for CRM systems, AI agents and automated workflows. It explains the callable flow, authentication, product routing and beta limits.",
        "tags": ["Machine Discovery"],
        "responses": {
          "200": {
            "description": "Machine onboarding manifest returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/lead-opportunity-score": {
      "post": {
        "operationId": "scoreLeadOpportunity",
        "summary": "Score a business domain",
        "description": "Receives a business domain and returns an opportunity score, machine decision, budget routing and recommended next product.",
        "tags": ["Lead Opportunity Score"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadOpportunityScoreRequest"
              },
              "examples": {
                "syntheticDomain": {
                  "summary": "Synthetic beta example",
                  "value": {
                    "domain": "clinic3.it",
                    "sector_hint": "dentist",
                    "country_hint": "IT"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Opportunity score generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadOpportunityScoreResponse"
                },
                "examples": {
                  "highPriority": {
                    "summary": "High priority synthetic example",
                    "value": {
                      "domain": "clinic3.it",
                      "opportunity_score": 81,
                      "confidence": 0.79,
                      "priority": "high",
                      "decision": "buy_deep_analysis",
                      "reason": "Signals suggest a high-priority opportunity where a paid deep analysis may be justified.",
                      "recommended_action": "buy_deep_analysis",
                      "product_level": "score_base",
                      "score_price_range_eur": "0.05-0.20",
                      "next_purchase": {
                        "next_product": "deep_analysis",
                        "price_range_eur": "1-3",
                        "machine_instruction": "Buy Deep Analysis before spending human or campaign budget."
                      },
                      "machine_next_step": {
                        "action": "buy_deep_analysis",
                        "budget_action": "consider_deep_analysis",
                        "max_extra_spend_eur": "1-3",
                        "instruction": "Buy Deep Analysis before spending human or campaign budget."
                      },
                      "beta": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid domain or request body"
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Read credit ledger usage",
        "description": "Returns package balances, last usage events and the current demo ledger status. Machines use this endpoint to verify how many credits were consumed and what remains.",
        "tags": ["Usage"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usage ledger returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsagePayload"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/onboarding": {
      "get": {
        "operationId": "getAuthenticatedMachineOnboarding",
        "summary": "Read customer-specific machine onboarding",
        "description": "Returns customer-specific onboarding state, available endpoints, credit balances and next machine actions.",
        "tags": ["Machine Discovery"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated onboarding returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/purchase-intent": {
      "post": {
        "operationId": "createPurchaseIntent",
        "summary": "Create beta order intent and receive delivery",
        "description": "Creates a beta order for verification, nurture signal, deep analysis or action pack. In beta it consumes credits and returns an immediate machine-readable delivery, without real payment execution.",
        "tags": ["Orders"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Use this to avoid duplicate charging when a machine retries the same order."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["domain", "product_code"],
                "properties": {
                  "domain": {
                    "type": "string",
                    "examples": ["clinic3.it"]
                  },
                  "product_code": {
                    "type": "string",
                    "enum": ["verification", "nurture_signal", "deep_analysis", "action_pack"]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "max_budget_eur": {
                    "type": "number"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order intent accepted and beta delivery returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "402": {
            "description": "Insufficient credits"
          }
        }
      }
    },
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List beta orders and deliveries",
        "description": "Returns beta order intents and machine-readable deliveries created by the authenticated customer machine.",
        "tags": ["Orders"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Orders returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/beta/customers": {
      "post": {
        "operationId": "createBetaCustomer",
        "summary": "Admin-only customer API key creation",
        "description": "Admin-only beta endpoint. Creates a machine customer, assigns initial credits and returns a dedicated API key once.",
        "tags": ["Admin"],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin API key"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "LeadOpportunityScoreRequest": {
        "type": "object",
        "required": ["domain"],
        "properties": {
          "domain": {
            "type": "string",
            "description": "Business domain to score. The beta expects a domain without protocol.",
            "examples": ["clinic3.it"]
          },
          "sector_hint": {
            "type": "string",
            "description": "Optional sector hint used to improve interpretation.",
            "examples": ["dentist"]
          },
          "country_hint": {
            "type": "string",
            "description": "Optional ISO-style country hint.",
            "examples": ["IT"]
          }
        },
        "additionalProperties": false
      },
      "LeadOpportunityScoreResponse": {
        "type": "object",
        "required": [
          "domain",
          "opportunity_score",
          "confidence",
          "priority",
          "decision",
          "reason",
          "recommended_action",
          "product_level",
          "next_purchase",
          "machine_next_step",
          "request_id",
          "usage"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "opportunity_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Higher scores indicate stronger potential opportunity for analysis or follow-up."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "reason": {
            "type": "string",
            "description": "Short human-readable explanation of the score."
          },
          "recommended_action": {
            "type": "string",
            "enum": ["discard", "watchlist", "nurture", "buy_deep_analysis", "needs_verification"]
          },
          "decision": {
            "type": "string",
            "enum": ["discard", "watchlist", "nurture", "buy_deep_analysis", "needs_verification"],
            "description": "Machine-ready decision. This is the primary routing instruction."
          },
          "product_level": {
            "type": "string",
            "enum": ["score_base"]
          },
          "score_price_range_eur": {
            "type": "string",
            "description": "Indicative commercial range for a base score in paid mode."
          },
          "next_purchase": {
            "$ref": "#/components/schemas/NextPurchase"
          },
          "machine_next_step": {
            "$ref": "#/components/schemas/MachineNextStep"
          },
          "request_id": {
            "type": "string",
            "description": "Idempotency/request identifier used by the credit ledger."
          },
          "usage": {
            "$ref": "#/components/schemas/UsagePayload"
          },
          "beta": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "NextPurchase": {
        "type": "object",
        "required": ["next_product", "price_range_eur", "machine_instruction"],
        "properties": {
          "next_product": {
            "type": ["string", "null"],
            "enum": ["deep_analysis", "nurture_signal", "verification", null]
          },
          "price_range_eur": {
            "type": "string"
          },
          "machine_instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MachineNextStep": {
        "type": "object",
        "required": ["action", "budget_action", "max_extra_spend_eur", "instruction"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["discard", "watchlist", "nurture", "buy_deep_analysis", "needs_verification"]
          },
          "budget_action": {
            "type": "string"
          },
          "max_extra_spend_eur": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UsagePayload": {
        "type": "object",
        "required": [
          "customer_id",
          "ledger_persisted",
          "balances",
          "last_events",
          "rule",
          "real_payment_executed",
          "external_contact_executed"
        ],
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "ledger_persisted": {
            "type": "boolean",
            "description": "True when the ledger is backed by persistent storage such as Cloudflare KV."
          },
          "balances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerBalance"
            }
          },
          "current_event": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LedgerEvent"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEvent"
            }
          },
          "rule": {
            "type": "string"
          },
          "real_payment_executed": {
            "type": "boolean",
            "description": "The demo does not execute real payments."
          },
          "external_contact_executed": {
            "type": "boolean",
            "description": "The demo does not contact external targets."
          }
        },
        "additionalProperties": false
      },
      "LedgerBalance": {
        "type": "object",
        "required": ["product_code", "credits_purchased", "credits_used", "credits_remaining"],
        "properties": {
          "product_code": {
            "type": "string",
            "examples": ["score_pack_1k"]
          },
          "credits_purchased": {
            "type": "integer"
          },
          "credits_used": {
            "type": "integer"
          },
          "credits_remaining": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "LedgerEvent": {
        "type": "object",
        "required": [
          "event_id",
          "timestamp",
          "customer_id",
          "product_code",
          "request_id",
          "status",
          "reason",
          "units_requested",
          "credits_consumed",
          "credits_remaining"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "customer_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["valid_output", "blocked_insufficient_credits"]
          },
          "reason": {
            "type": "string"
          },
          "units_requested": {
            "type": "integer"
          },
          "credits_consumed": {
            "type": "integer"
          },
          "credits_remaining": {
            "type": "integer"
          },
          "duplicate_request": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
